{
  "name": "escuela-visible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:types": "npx supabase@latest gen types typescript --linked --schema public > src/types/database.ts",
    "script": "tsx --conditions=react-server",
    "env:check": "tsx --conditions=react-server scripts/env-check.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:pglite": "node scripts/regression/run.mjs pglite",
    "test:privacy": "node scripts/regression/secret-scan.mjs",
    "test:bundle": "node scripts/regression/bundle-scan.mjs",
    "test:regression": "node scripts/regression/run.mjs regression",
    "test:regression:http": "node scripts/regression/run.mjs http",
    "hedera:check": "tsx --conditions=react-server scripts/hedera-check.ts",
    "hedera:create-topic": "tsx --conditions=react-server scripts/hedera-create-topic.ts",
    "hedera:verify": "tsx --conditions=react-server scripts/hedera-verify.ts",
    "demo:accounts": "tsx --conditions=react-server scripts/demo-accounts.ts",
    "e2e:first-event": "tsx --conditions=react-server scripts/e2e-first-event.ts",
    "e2e:validate-need": "tsx --conditions=react-server scripts/e2e-validate-need.ts",
    "e2e:commitment": "tsx --conditions=react-server scripts/e2e-commitment-flow.ts",
    "cases:schools": "tsx --conditions=react-server scripts/documented-schools.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.89.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "ws": "8.22.0",
    "@hiero-ledger/proto": {
      "protobufjs": "8.6.6"
    }
  }
}
