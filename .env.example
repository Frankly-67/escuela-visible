# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a Git. Producción (Vercel): ver docs/DEPLOY.md.
#
# NEXT_PUBLIC_* = PÚBLICAS: se incrustan en el bundle del navegador al hacer el build
#                 (en Vercel deben existir ANTES del build).
# El resto       = SOLO SERVIDOR: nunca con prefijo NEXT_PUBLIC_.

# --- Sitio (pública) ---
# URL canónica del sitio (metadataBase). Local: http://localhost:3000.
# En producción: la URL pública definitiva del despliegue (sin barra final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
# Públicas: se incluyen en el bundle del navegador.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secreta: SOLO servidor. Sin prefijo NEXT_PUBLIC_. Salta RLS.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Hedera (SOLO servidor) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
# Clave privada de la cuenta operadora (DER o hex). Secreta.
HEDERA_OPERATOR_KEY=
# ecdsa (por defecto en portal.hedera.com) o ed25519
HEDERA_OPERATOR_KEY_TYPE=ecdsa
# Topic existente del proyecto (ver docs/DEPLOY.md). No crear uno nuevo para desplegar.
HEDERA_TOPIC_ID=0.0.xxxxx
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# --- Cuentas DEMO (SOLO scripts locales y regresiones; NO configurar en Vercel) ---
# Contraseña de las 5 cuentas DEMO (mínimo 12 caracteres). Nunca en Git.
DEMO_ACCOUNT_PASSWORD=
