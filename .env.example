# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a Git.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
# Públicas: se incluyen en el bundle del navegador.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secreta: SOLO servidor. Sin prefijo NEXT_PUBLIC_. Salta RLS.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Hedera (SOLO servidor) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
# Clave privada de la cuenta operadora (DER o hex).
HEDERA_OPERATOR_KEY=
# ecdsa (por defecto en portal.hedera.com) o ed25519
HEDERA_OPERATOR_KEY_TYPE=ecdsa
# Se obtiene al ejecutar el script de creación del topic (fase 2).
HEDERA_TOPIC_ID=0.0.xxxxx
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
